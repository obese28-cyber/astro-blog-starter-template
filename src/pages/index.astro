---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>OrbitLink Communications</h1>

			<p>
				OrbitLink Communications is a Ghana-based digital infrastructure initiative focused on satellite-enabled broadband deployment for underserved communities, enterprises, and institutions across West Africa.
			</p>

			<p>
				We work with international satellite infrastructure providers and telecommunications partners to deliver reliable, affordable connectivity where traditional networks are limited or unavailable.
			</p>

			<h2>Our Focus</h2>
			<ul>
				<li>Satellite-enabled broadband connectivity</li>
				<li>Rural and underserved community internet access</li>
				<li>Enterprise-grade backup connectivity solutions</li>
				<li>Institutional networks (schools, healthcare, government)</li>
			</ul>

			<h2>Partnership Model</h2>
			<p>
				OrbitLink operates as a local deployment and infrastructure partner, connecting global satellite technology providers with on-the-ground implementation, distribution, and customer support in Ghana.
			</p>

			<h2>Contact</h2>
			<p>
				Email: partnerships@orbitlink.com
			</p>
		</main>
		<Footer />
	</body>
</html>
